# Optional managed MySQL persistence. When absent, local development uses data/ecotwin.json.
DATABASE_URL=

# Server-only Gemini REST integration. The current default accepts image inputs.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional platform values are supplied by the managed Webdev runtime when available.
# They are not required for the local JSON fallback.
MANUS_API_URL=
MANUS_API_KEY=
